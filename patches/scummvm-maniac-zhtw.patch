+			byte *dstPtr = _compositeBuf;
+
+			for (int h = 0; h < height * m; ++h) {
+				const byte *s = srcRow;
+				const byte *t = textRow;
+				for (int w = 0; w < width; ++w) {
+					byte bg = *s++;
