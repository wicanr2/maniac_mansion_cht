diff --git a/engines/scumm/script_v2.cpp b/engines/scumm/script_v2.cpp
index 241d938a..509ef832 100644
--- a/engines/scumm/script_v2.cpp
+++ b/engines/scumm/script_v2.cpp
@@ -373,6 +373,18 @@ void ScummEngine_v2::decodeParseString() {
 
 	while ((c = fetchScriptByte())) {
 
+		// 繁中化：自訂碼空間的首碼落在 0x88-0x9F，該位元組與下一個原樣寫入。
+		//
+		// v2 的腳本字串用「位元組 | 0x80」表示「該位元組後面接一個空白」（空白壓縮），
+		// 底下的 `c &= 0x7f` 會把任何高位元砍掉，中文因此完全進不來。首碼避開了所有
+		// 壓縮得出來的值：可列印 ASCII (0x20-0x7E) | 0x80 = 0xA0-0xFE，以及控制碼
+		// 0x01-0x03 | 0x80 = 0x81-0x83（片頭字幕 `by\001     Ron` 就會壓出 0x81）。
+		if (_useCJKMode && c >= 0x88 && c <= 0x9F) {
+			*ptr++ = c;
+			*ptr++ = fetchScriptByte();
+			continue;
+		}
+
 		insertSpace = (c & 0x80) != 0;
 		c &= 0x7f;
 
diff --git a/engines/scumm/verbs.cpp b/engines/scumm/verbs.cpp
index 1637dd33..b45919c2 100644
--- a/engines/scumm/verbs.cpp
+++ b/engines/scumm/verbs.cpp
@@ -485,6 +485,23 @@ void ScummEngine_v2::redrawV2Inventory() {
 		msg[maxChars] = 0;
 		strncpy((char *)msg, (const char *)tmp, maxChars);
 
+		// 繁中化：上面的 strncpy 是按 byte 截斷，可能把雙位元組字砍成半個
+		// （只留下首碼），畫面上會出現一個亂碼字。往前掃到最後一個完整的字。
+		if (_useCJKMode && _language == Common::ZH_CHN) {
+			int cut = 0;
+			for (int k = 0; msg[k]; ) {
+				if (msg[k] >= 0x88 && msg[k] <= 0x9F) {
+					if (!msg[k + 1])
+						break;
+					k += 2;
+				} else {
+					k += 1;
+				}
+				cut = k;
+			}
+			msg[cut] = 0;
+		}
+
 		// Draw it
 		drawString(1, msg);
 	}
