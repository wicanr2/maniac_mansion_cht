+#include "common/config-manager.h"
 #include "ags/shared/font/ttf_font_renderer.h"
 #include "ags/lib/alfont/alfont.h"
 #include "ags/shared/core/platform.h"
@@ -126,6 +127,29 @@ bool TTFFontRenderer::LoadFromDiskEx(int fontNumber, int fontSize, String *src_f
 	if (f_params.SizeMultiplier > 1)
 		fontSize *= f_params.SizeMultiplier;
 
+	// Pre-3.x games have no font size in their data, so a substituted TTF is always
+	// loaded at the 8px compatibility size above. That is unreadable for CJK glyphs,
+	// and the nominal size also drives line spacing, so it cannot be worked around
+	// by scaling the font file itself. Allow the config to override it; unset keeps
+	// the original behaviour.
+	if (ConfMan.hasKey("ags_ttf_font_size")) {
+		int overrideSize = ConfMan.getInt("ags_ttf_font_size");
+		if (overrideSize > 0)
+			fontSize = overrideSize;
+	}
+	// Per-slot override on top of that. Games use different font slots for speech and
+	// for GUI labels, and the space available to each is not the same: in Maniac Mansion
+	// Deluxe the sentence line only has an 18px gap above the verb buttons, so a 24px
+	// speech font would have its lower half painted over by the verb GUI.
+	char perFontKey[40];
+	Common::sprintf_s(perFontKey, "ags_ttf_font_size_%d", fontNumber);
+	if (ConfMan.hasKey(perFontKey)) {
+		int slotSize = ConfMan.getInt(perFontKey);
+		if (slotSize > 0)
+			fontSize = slotSize;
+	}
+	debug(1, "AGS: loading TTF font %d at size %d", fontNumber, fontSize);
+
